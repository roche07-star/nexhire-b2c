# =============================================================================
# 🔐 NEXHIRE B2C 환경변수 설정 가이드
# =============================================================================
# 이 파일을 복사하여 .env.local로 이름을 변경하고 실제 값을 입력하세요.
# .env.local 파일은 .gitignore에 포함되어 있어 Git에 커밋되지 않습니다.
# =============================================================================

# -----------------------------------------------------------------------------
# NextAuth (인증)
# -----------------------------------------------------------------------------
# NextAuth Secret: openssl rand -base64 32 명령어로 생성
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
# Google Cloud Console에서 OAuth 2.0 클라이언트 ID 생성
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# Supabase (데이터베이스)
# -----------------------------------------------------------------------------
# Supabase 프로젝트 설정에서 확인
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# Anthropic Claude API (AI 기능)
# -----------------------------------------------------------------------------
# Anthropic Console에서 API 키 생성
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# -----------------------------------------------------------------------------
# Vercel KV (Redis 캐시 & Rate Limiting)
# -----------------------------------------------------------------------------
# Vercel 프로젝트 설정 > Storage > KV에서 자동 생성
# https://vercel.com/dashboard/stores
KV_REST_API_URL=https://...kv.vercel-storage.com
KV_REST_API_TOKEN=your-kv-token
VERCEL_KV_REST_API_URL=https://...kv.vercel-storage.com

# -----------------------------------------------------------------------------
# PortOne (결제 게이트웨이)
# -----------------------------------------------------------------------------
# PortOne Console에서 확인
# https://admin.portone.io/
NEXT_PUBLIC_PORTONE_STORE_ID=store-...
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-...
PORTONE_API_SECRET=your-portone-api-secret

# -----------------------------------------------------------------------------
# Toss Payments (결제 게이트웨이)
# -----------------------------------------------------------------------------
# Toss Payments 개발자센터에서 확인
# https://developers.tosspayments.com/my/api-keys
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...

# -----------------------------------------------------------------------------
# Telegram Bot (알림)
# -----------------------------------------------------------------------------
# @BotFather를 통해 봇 생성 후 토큰 발급
# Admin Chat ID는 @userinfobot에서 확인
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ADMIN_CHAT_ID=123456789

# -----------------------------------------------------------------------------
# Slack (보안 알림)
# -----------------------------------------------------------------------------
# Slack Incoming Webhook URL
# https://api.slack.com/messaging/webhooks
SLACK_SECURITY_WEBHOOK_URL=https://hooks.slack.com/services/...

# -----------------------------------------------------------------------------
# 기타
# -----------------------------------------------------------------------------
# Node 환경 (development, production, test)
NODE_ENV=development

# Sentry DSN (선택사항)
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# Vercel Analytics (선택사항)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=...
